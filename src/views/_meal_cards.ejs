<% if (cards.length === 0) { %>
<p class="empty">対象期間外です。</p>
<% } %>
<% for (const card of cards) { %>
<section class="card <%= card.state %>">
  <h2><%= card.title %>ごはん</h2>
  <p class="state">
    <% if (card.state === 'open') { %><%= card.closes %> まで<% } else { %>締切<% } %>
  </p>
  <% if (card.state === 'open') { %>
  <div class="sizes">
    <% for (const size of config.RICE_SIZES) { %>
    <form method="post" action="<%= base %>/meals/vote">
      <input type="hidden" name="date" value="<%= card.day %>">
      <input type="hidden" name="kind" value="<%= card.kind %>">
      <input type="hidden" name="size" value="<%= size %>">
      <button type="submit" class="btn <%= card.voted === size ? 'voted' : '' %>">
        <%= config.RICE_LABELS[size] %><% if (card.voted === size) { %> ✓<% } %>
        <small><%= formatGo(config.RICE_GO[size]) %>合</small>
      </button>
    </form>
    <% } %>
  </div>
  <% if (card.voted) { %>
  <form method="post" action="<%= base %>/meals/unvote">
    <input type="hidden" name="date" value="<%= card.day %>">
    <input type="hidden" name="kind" value="<%= card.kind %>">
    <button type="submit" class="link">キャンセル</button>
  </form>
  <% } %>
  <% } %>
  <p class="count"><%= card.total %>合</p>
  <p class="sub">いる <%= card.wanted %>人 / 登録 <%= card.registered %>人</p>
</section>
<% } %>
